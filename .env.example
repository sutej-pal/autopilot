# Dev-only vault key. Production must use KMS and must not start with this key.
LOCAL_VAULT_KEY=dev-only-change-me
API_HOST=127.0.0.1
API_PORT=3001
# Leave unset in Phase 1. The API runs replays in-process until Redis is wired and tested.
# REDIS_URL=redis://127.0.0.1:6379
# Render sets these. AUTOPILOT_TOKEN is required to open the public site.
# DATA_FILE=/var/data/store.json
# AUTOPILOT_TOKEN=
